  "narrative": {
    "northStar": "Connected context",
    "overview": "A calm, accountable interface uses cool neutral surfaces, semantic blue emphasis, system typography and fine separators to keep relationships understandable. Depth is restrained and information remains explicit in both themes.\n\nThe finished homepage expresses this through a connected delivery record, varied editorial sections and a linked workflow. These are observed homepage patterns, not mandatory compositions for every future screen.",
    "keyCharacteristics": [
      "Semantic light and dark color roles.",
      "System typography and a four-pixel spacing rhythm.",
      "Explicit relationships, readable labels and modest preview claims."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Use each surface with its paired foreground; status meaning also needs text.",
        "section": "colors"
      },
      {
        "name": "The System Type Rule",
        "body": "Keep the existing system sans stack and type scale, capped at text-4xl.",
        "section": "typography"
      },
      {
        "name": "The Restrained Depth Rule",
        "body": "Use the two existing shadows for contained records and overlays; ordinary separation uses borders and tonal surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do compose existing shadcn primitives and semantic HTML.",
      "Do retain readable wrapping, visible focus, reduced motion and both themes.",
      "Do label illustrative records and keep work, verification, acceptance and release distinct."
    ],
    "donts": [
      "Don't change frozen tokens, generated primitives, dependencies or routes without explicit approval.",
      "Don't add fonts, colors, gradients, decorative imagery, motion or component variants.",
      "Don't turn role labels, example approvals or preview actions into authorization or successful-write claims."
    ]
  }
