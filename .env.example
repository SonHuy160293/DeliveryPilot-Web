# Local same-origin frontend -> YARP Identity. Copy to .env.local and restart Vite.
# VITE_ values are public browser configuration; never put credentials here.
VITE_API_BASE_URL=/identity/
VITE_API_TIMEOUT_MS=15000
DEV_API_PROXY_TARGET=http://127.0.0.1:19090
DEV_API_PROXY_PREFIX=/identity
DEV_API_PROXY_STRIP_PREFIX=false
